{
  "name": "xraybox",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --debug",
    "android:release": "bash scripts/android-release.sh",
    "windows:release": "tauri build --bundles nsis,msi",
    "macos:dev": "tauri dev",
    "macos:build": "tauri build --bundles app,dmg",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build --debug",
    "ios:release": "bash scripts/ios-release.sh",
    "icon": "tauri icon src-tauri/icons/icon.svg",
    "bootlog": "adb shell run-as io.github.xraybox cat files/xraybox-boot.log"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "flag-icons": "^7.5.0",
    "jsqr": "^1.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
