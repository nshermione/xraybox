{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xraybox",
  "version": "0.1.0",
  "identifier": "io.github.xraybox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "xraybox",
        "width": 470,
        "height": 850,
        "backgroundColor": "#151024"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/assets/geoip.dat": "resources/assets/geoip.dat",
      "resources/assets/geosite.dat": "resources/assets/geosite.dat"
    }
  }
}
